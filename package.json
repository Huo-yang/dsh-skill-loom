{
  "name": "@huo-yang/dsh-skill-loom",
  "version": "0.1.1",
  "type": "module",
  "description": "Compose skill dependency graphs into session-scoped roles and reusable ability families for DeepSeek Harness.",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs/ARCHITECTURE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm test"
  },
  "homepage": "https://github.com/Huo-yang/dsh-skill-loom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huo-yang/dsh-skill-loom.git"
  },
  "bugs": {
    "url": "https://github.com/Huo-yang/dsh-skill-loom/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "roles",
    "dag"
  ]
}
