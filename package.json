{
  "name": "dsh-skill-loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weave skills into roles: per-role skill dependency graphs for DeepSeek Harness",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm test"
  }
}
